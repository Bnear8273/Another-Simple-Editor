{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (clang++)",
      "type": "process",
      "command": "make",
      "args": ["build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Run",
      "type": "process",
      "command": "make",
      "args": ["run"],
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
